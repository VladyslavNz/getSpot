{
  "theme": "Light/White Premium Glassmorphism",
  "archetype": "3 (Pastel & Soft) mixed with Apple-level clear aesthetics",
  "colors": {
    "background": "#F5EFE6",
    "surface": "#E8DFCA",
    "primary": "#6D94C5",
    "secondary": "#CBDCEB",
    "text": {
      "primary": "#1C1C1E",
      "secondary": "#8E8E93",
      "tertiary": "#C7C7CC"
    },
    "glass": {
      "light": "rgba(255, 255, 255, 0.6)",
      "medium": "rgba(255, 255, 255, 0.4)",
      "border": "rgba(255, 255, 255, 0.8)"
    }
  },
  "typography": {
    "fontFamily": "System, Satoshi, General Sans",
    "scale": {
      "h1": {
        "fontSize": 34,
        "fontWeight": "700",
        "letterSpacing": 0.4
      },
      "h2": {
        "fontSize": 28,
        "fontWeight": "600",
        "letterSpacing": 0.3
      },
      "h3": {
        "fontSize": 22,
        "fontWeight": "600",
        "letterSpacing": 0.2
      },
      "bodyLarge": {
        "fontSize": 17,
        "fontWeight": "400",
        "letterSpacing": -0.4
      },
      "bodySmall": {
        "fontSize": 15,
        "fontWeight": "400",
        "letterSpacing": -0.2
      },
      "caption": {
        "fontSize": 13,
        "fontWeight": "500",
        "letterSpacing": 0
      }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "2xl": 48
  },
  "radii": {
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "full": 9999
  },
  "shadows": {
    "sm": {
      "shadowColor": "#000",
      "shadowOffset": {
        "width": 0,
        "height": 2
      },
      "shadowOpacity": 0.05,
      "shadowRadius": 8,
      "elevation": 2
    },
    "md": {
      "shadowColor": "#000",
      "shadowOffset": {
        "width": 0,
        "height": 8
      },
      "shadowOpacity": 0.08,
      "shadowRadius": 16,
      "elevation": 4
    },
    "lg": {
      "shadowColor": "#000",
      "shadowOffset": {
        "width": 0,
        "height": 16
      },
      "shadowOpacity": 0.12,
      "shadowRadius": 32,
      "elevation": 8
    }
  },
  "components": {
    "GlassCard": {
      "description": "Premium glass card component. In React Native, use Expo BlurView with intensity=50-70, tint='light', wrap in a View with shadow-md, and add a 1px inner border using border width 1 and border color rgba(255,255,255,0.8)."
    },
    "FloatingBottomNav": {
      "description": "Capsule shape (rounded-full), positioned absolutely at bottom: 32. Uses BlurView for glass effect. Center FAB is slightly elevated and protrudes above the nav bar."
    },
    "PillChips": {
      "description": "Horizontal scroll view of filter chips. Active state: solid primary (#6D94C5) or bright white. Inactive state: translucent glass. Fully rounded."
    },
    "StoryRing": {
      "description": "Circular avatar wrapped in a LinearGradient border (using expo-linear-gradient) with a 2px padding between the image and border."
    },
    "EventCard": {
      "description": "Large card with full image background. A BlurView overlay at the bottom 30% of the card containing title, date, and 'Going' button."
    },
    "ChatBubble": {
      "description": "Rounded rectangles (varying radii on the tail edge). User messages: Primary blue (#6D94C5). Other messages: Glass/white."
    },
    "MapOverlay": {
      "description": "Floating elements over react-native-maps. Top search bar is glass. Bottom carousel of spots uses smaller GlassCards."
    }
  },
  "screens": {
    "MapTab": {
      "layout": "Full screen map. Floating search bar top. Floating 'current location' button. Bottom horizontal FlatList for nearby spots."
    },
    "DiscoverTab": {
      "layout": "Header with 'Hi, Name' + Date. Story rings horizontal strip. Pill filters. Vertical FlatList of immersive Event Cards."
    },
    "ChatsTab": {
      "layout": "List of recent chats. Each row has an avatar, name, last message, time, and unread badge. Glass card styling for rows."
    },
    "ProfileTab": {
      "layout": "Header with large avatar, verified badge. Stat cards (glass). Segmented control (Feed / Saved / Going). Masonry or Grid of user posts."
    },
    "CreateModal": {
      "layout": "Bottom sheet modal using react-native-modal or reanimated. Glassmorphism background. Options: Create Event, Add Spot, Post Story."
    },
    "TopSpots": {
      "layout": "Search bar top, Category chips, Vertical list of Spot cards (thumbnail left, details right, glass container)."
    }
  },
  "animations": {
    "spring": {
      "damping": 20,
      "stiffness": 200,
      "mass": 1
    },
    "transitions": "Use react-native-reanimated for shared element transitions (e.g., Event Card to Event Detail)."
  },
  "iconography": {
    "library": "lucide-react-native",
    "strokeWidth": 2,
    "size": {
      "sm": 16,
      "md": 24,
      "lg": 32
    }
  },
  "testing": {
    "attribute": "testID",
    "convention": "kebab-case, role-based"
  },
